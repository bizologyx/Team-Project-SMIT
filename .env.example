# Copy this file to .env and fill in values. Never commit .env.
PORT=3000
NODE_ENV=development

# OpenAI (translation + speech generation; billed API usage)
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Zoom Meeting SDK credentials from Zoom App Marketplace. Server-side only.
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# Optional: configure only after creating an RTMS-enabled Zoom app and validating
# the official SDK/webhook flow for your account and deployment environment.
ZOOM_RTMS_CLIENT_ID=
ZOOM_RTMS_CLIENT_SECRET=
ZOOM_RTMS_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-public-https-domain.example
