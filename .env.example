# Copy this file to .env and fill in values. Never commit .env.
PORT=3000
NODE_ENV=development

# Firebase Authentication & Firestore Configuration (Client side keys)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id-here
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id-here
FIREBASE_PROJECT_ID=your-project-id-here

# OpenAI (translation + speech generation; billed API usage)
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Zoom Meeting SDK credentials from Zoom App Marketplace. Server-side only.
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# RTMS-capable user-managed Zoom Marketplace app; configure on a Linux/macOS backend.
# Subscribe to meeting.rtms_started and meeting.rtms_stopped, add
# meeting:read:meeting_transcript, and set the webhook URL to /api/zoom/rtms/webhook.
ZOOM_RTMS_CLIENT_ID=
ZOOM_RTMS_CLIENT_SECRET=
ZOOM_RTMS_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-public-https-domain.example
