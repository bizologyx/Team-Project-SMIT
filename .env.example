# Copy this file to .env and fill in values. Never commit .env.
PORT=3000
NODE_ENV=development

# Supabase Authentication & Database Configuration (Public / Client keys)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OpenAI (translation + speech generation; billed API usage)
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Zoom Meeting SDK credentials from Zoom App Marketplace. Server-side only.
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# Optional RTMS & Base URL
ZOOM_RTMS_CLIENT_ID=
ZOOM_RTMS_CLIENT_SECRET=
ZOOM_RTMS_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-public-https-domain.example
