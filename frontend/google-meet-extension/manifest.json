{
  "manifest_version": 3,
  "name": "Transzo AI — Google Meet Companion",
  "version": "0.1.0",
  "description": "Translate visible Google Meet captions between English and Urdu with your Transzo AI backend.",
  "icons": {
    "16": "Glossy Transzo AI App Icon (1).png",
    "32": "Glossy Transzo AI App Icon (1).png",
    "48": "Glossy Transzo AI App Icon (1).png",
    "128": "Glossy Transzo AI App Icon (1).png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Transzo AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}